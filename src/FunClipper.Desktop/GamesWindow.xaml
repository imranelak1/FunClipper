<Window x:Class="FunClipper.Desktop.GamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Games · FunClipper"
        Width="620" Height="580" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2F293D" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B7A1FF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Games" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Steam, Epic and supported games are detected locally. Capture still records screen 1 and starts when you choose Start capture." Foreground="{StaticResource SecondaryInk}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,18,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><Label Target="{Binding ElementName=GameName}" Content="Game name (optional)" Padding="0" Foreground="{StaticResource Ink}" Margin="0,0,0,6" /><TextBox x:Name="GameName" MinHeight="36" AutomationProperties.Name="Custom game name" ToolTip="Leave blank to use the executable's name." /></StackPanel>
      <Button x:Name="AddButton" Grid.Column="1" Content="Add game executable…" Click="Add_Click" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="0" />
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,0,0,8"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right" Margin="0" MinHeight="30" Padding="12,5" /><TextBlock Text="Running games" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
    <Grid Grid.Row="3">
      <ListBox x:Name="RunningList" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Detected running games">
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="NoRunning" Text="No game is running. Open a game to detect it." Foreground="{StaticResource SecondaryInk}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False" />
    </Grid>
    <TextBlock Grid.Row="4" Text="Your added games" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
    <Grid Grid.Row="5">
      <ListBox x:Name="RegisteredList" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Custom game executables">
        <ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Click="Remove_Click" Tag="{Binding}" Margin="12,0,0,0" MinHeight="30" Padding="10,5" /><StackPanel VerticalAlignment="Center" ToolTip="{Binding ExecutablePath}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ExecutableName}" Foreground="{StaticResource SecondaryInk}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="NoRegistered" Text="Add an executable if your game isn't recognized." Foreground="{StaticResource SecondaryInk}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False" />
    </Grid>
    <TextBlock x:Name="GameManagerStatus" Grid.Row="6" Text="Looking for games…" FontSize="12" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</Window>
