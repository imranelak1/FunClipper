<Window x:Class="FunClipper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="FunClipper" Width="850" Height="660" MinWidth="730" MinHeight="520"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Widget" Click="Widget_Click" ToolTip="Show floating recording controls and PC vitals" />
        <Button Content="Web library" Click="Library_Click" />
        <Button Content="Connection" Click="Connection_Click" Margin="0" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="FunClipper" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Keep the moment." Foreground="{StaticResource SecondaryInk}" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,0,18">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="CaptureButton" Content="Start capture" Click="Capture_Click" Style="{StaticResource Primary}" />
            <Button x:Name="SaveButton" Content="Save clip · F8" Click="Save_Click" IsEnabled="False" Margin="0" />
          </StackPanel>
          <ComboBox x:Name="ProfileChoice" Width="222" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="Recording quality">
            <ComboBoxItem Content="Minimum · 480p / 30 FPS" />
            <ComboBoxItem Content="Low-end · 720p / 30 FPS" />
            <ComboBoxItem Content="Standard · 1080p / 60 FPS" />
          </ComboBox>
        </DockPanel>
        <TextBlock x:Name="CaptureStatus" Text="Desktop replay · screen 1 · recording starts when you choose Start capture." Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" Margin="0,14,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <TextBlock x:Name="VitalsLine" Text="Reading PC vitals…" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="CostLine" Text="Reading app resource use…" FontSize="12" Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Content="Import MP4" Click="Import_Click" Margin="0" />
        <TextBlock Text="Recent clips" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}" CornerRadius="9">
        <Grid>
          <ListBox x:Name="ClipList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Clip_DoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,8" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#242831" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2F293D" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B7A1FF" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#303540" BorderThickness="0,0,0,1" Padding="0,7,0,12">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Edit" Click="EditClip_Click" Tag="{Binding}" />
                      <Button Content="Share" Click="ShareClip_Click" Tag="{Binding}" Margin="0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Width="72" Height="44" Background="#272C36" CornerRadius="5" Margin="0,0,14,0" ToolTip="Open clip to preview">
                      <Path Data="M 0 0 L 0 16 L 13 8 Z" Fill="#77718B" Width="12" Height="15" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,5" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SecondaryInk}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Border Width="48" Height="48" Background="#2E283E" CornerRadius="10" Margin="0,0,0,16"><Path Data="M 3 0 L 18 0 L 18 18 L 0 18 L 0 3 M 6 6 L 12 9 L 6 12 Z" Stroke="#B7A1FF" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" /></Border>
            <TextBlock Text="Your clips will appear here" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Start capture, then press F8 when something worth keeping happens." Foreground="{StaticResource SecondaryInk}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBox Grid.Row="4" x:Name="ActivityStatus" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="Capture and sharing status" Text="Recording starts only when you choose Start capture. Closing this window keeps the tray app running." Foreground="{StaticResource SecondaryInk}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
  </Grid>
</Window>
