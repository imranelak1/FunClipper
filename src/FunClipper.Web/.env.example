# Set these in your shell or container environment. The app does not load .env files.
# Generate a unique random key; never commit or expose the actual value.
FUNCLIPPER_SHARE_KEY=replace-with-a-random-key-at-least-32-characters
FUNCLIPPER_SHARE_DIR=/data
FUNCLIPPER_EXPIRY_DAYS=14
# Leave unset for localhost. Hosting requires HTTPS and a reachable service.
# FUNCLIPPER_PUBLIC_URL=https://clips.example.com
